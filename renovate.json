{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)",
    ":timezone(America/Sao_Paulo)",
    "schedule:weekdays"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts referenced from ArgoCD Applications (_root/*.yaml)",
      "fileMatch": ["^k8s/apps/_root/.+\\.yaml$"],
      "matchStrings": [
        "repoURL:\\s+(?<registryUrl>https?://[^\\s]+)\\s+chart:\\s+(?<depName>[^\\s]+)\\s+targetRevision:\\s+(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "ArgoCD install.yaml pinned in Kustomize",
      "fileMatch": ["^k8s/bootstrap/argocd/kustomization\\.yaml$"],
      "matchStrings": [
        "argoproj/argo-cd/(?<currentValue>v[^/]+)/manifests/install\\.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "argoproj/argo-cd"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": false
    },
    {
      "matchDatasources": ["helm"],
      "groupName": "helm charts"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "container images"
    }
  ]
}
