# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example.tfvars
.terraform.lock.hcl
crash.log

# Ansible
*.retry
ansible/inventory/*.ini
ansible/inventory/*.yml
!ansible/inventory/.gitkeep
!ansible/inventory/example.yml
!ansible/inventory/*.example.yml

# SOPS / age
*.age
age.key
age-key.txt
secrets/*.key

# Plaintext secrets must never be committed. Only encrypted `.enc.yaml`
# files are allowed to live under secrets/.
secrets/*.yaml
secrets/*.yml
!secrets/*.enc.yaml
!secrets/*.enc.yml
!secrets/README.md

# OCI
oci_api_key.pem
oci_api_key_public.pem
.oci/

# Kubernetes
kubeconfig
kubeconfig.*
*.kubeconfig

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Local overrides
*.local
.env
.env.*
!.env.example
