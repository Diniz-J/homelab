# Template for the `argocd-age-key` Secret the repo-server mounts.
#
# DO NOT commit this file in plaintext. The expected workflow is:
#
#   1. age-keygen -o age-key.txt
#   2. sops --encrypt --age <recipient> age-key.yaml > age-key.enc.yaml
#   3. Commit only `age-key.enc.yaml`.
#
# Alternatively (and simpler for the first bootstrap), create the
# Secret directly with `kubectl create secret generic argocd-age-key
# --from-file=keys.txt=age-key.txt` and keep it out of git entirely
# until the KSOPS chain is up.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-age-key
  namespace: argocd
type: Opaque
stringData:
  keys.txt: |
    # created: <timestamp>
    # public key: age1...
    AGE-SECRET-KEY-...
